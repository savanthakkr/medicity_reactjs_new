{
	"name": "vite-project",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --mode development --configLoader runner",
		"stage": "vite build --mode staging --configLoader runner && vite preview --configLoader runner --port 5000",
		"prod": "vite build --mode production --configLoader runner && vite preview --configLoader runner --port 5000",
		"build": "vite build --mode production --configLoader runner",
		"build:stage": "vite build --mode staging --configLoader runner",
		"lint": "eslint .",
		"check:errors": "eslint . --max-warnings=0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"prepare": "husky install",
		"preview": "vite preview --configLoader runner"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/roboto": "^5.2.10",
		"@mui/icons-material": "^9.0.0",
		"@mui/material": "^9.0.0",
		"@mui/x-charts": "^9.4.0",
		"@mui/x-date-pickers": "^9.0.0",
		"@tailwindcss/vite": "^4.1.11",
		"axios": "^1.16.0",
		"date-fns": "^4.4.0",
		"dayjs": "^1.11.10",
		"i18next": "^25.3.2",
		"i18next-browser-languagedetector": "^8.2.0",
		"jotai": "^2.20.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-error-boundary": "^6.1.1",
		"react-i18next": "^15.6.0",
		"react-router-dom": "^7.6.3",
		"tailwindcss": "^4.1.11"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.5.2",
		"eslint": "^9.30.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.3",
		"vite": "^7.0.0"
	}
}
